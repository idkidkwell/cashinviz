# ── Required ────────────────────────────────────────────────
# Relayer private key (this wallet pays gas and receives relayer fees).
# Keep this OFF the clearnet, encrypted at rest, and in a separate file
# (.env) that is git-ignored.
RELAYER_PRIVATE_KEY=0x...

# ── Server ──────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info                  # debug | info | warn | error

# Minimum relayer fee in ETH (requests below this are rejected with 400).
RELAYER_FEE=0.001

# Per-chain min fee overrides in WEI. The global RELAYER_FEE is in ETH
# but per-chain is in wei because chains have different native units
# (MATIC, BNB, AVAX, xDAI). Comment out a line to fall back to the
# global RELAYER_FEE for that chain.
# RELAYER_MIN_FEE_1=1000000000000000           # 0.001 ETH on mainnet
# RELAYER_MIN_FEE_137=50000000000000000        # 0.05 MATIC
# RELAYER_MIN_FEE_56=2000000000000000          # 0.002 BNB
# RELAYER_MIN_FEE_42161=300000000000000        # 0.0003 ETH on Arbitrum
# RELAYER_MIN_FEE_10=300000000000000           # 0.0003 ETH on Optimism
# RELAYER_MIN_FEE_8453=300000000000000         # 0.0003 ETH on Base

# Max write-endpoint requests per minute per IP (10 is a sensible default;
# raise for high-traffic relayers).
WRITE_RATE_LIMIT=10
# Max read-endpoint requests per minute per IP.
READ_RATE_LIMIT=120

# Optional: require clients to present this key in the `x-api-key` header.
# Leave unset to make the relayer fully public (recommended for censorship
# resistance; gated for commercial operators).
# RELAYER_API_KEY=

# Optional: separate key for /admin/* endpoints (balance, stats reset,
# nonce reset). Required to be present in the `x-admin-key` header. If
# this is unset, /admin/* returns 404 — admin mode is fully disabled.
# RELAYER_ADMIN_KEY=

# How long to wait for a broadcast tx to confirm before returning 500.
TX_CONFIRM_TIMEOUT_MS=120000

# Persistent stats file (best-effort; survives process restarts).
STATS_FILE=.stats.json

# CORS allowlist (comma-separated). Leave empty for wide-open CORS,
# which is the right default for a public censorship-resistant relayer.
# Set when running behind your own dapp UI:
# CORS_ORIGINS=https://app.example.org,https://example.org
CORS_ORIGINS=

# ── RPC endpoints per chain ─────────────────────────────────
# (get free keys from Alchemy / Infura / QuickNode — public endpoints
#  will rate-limit a busy relayer)
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL_POLYGON=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_BASE=
RPC_URL_BSC=
RPC_URL_AVALANCHE=
RPC_URL_GNOSIS=

# ── Mainnet MEV protection ──────────────────────────────────
# Route mainnet withdrawal broadcasts through a private mempool so
# searchers cannot frontrun/sandwich the transaction. Defaults to
# Flashbots Protect; replace with Blocknative, bloXroute, etc. as
# needed.
USE_PRIVATE_MEMPOOL=false
FLASHBOTS_RPC_URL=https://rpc.flashbots.net

# ── Tor egress (optional) ───────────────────────────────────
# Route every outbound JSON-RPC call through a local Tor SOCKS5
# proxy. Combined with running the relayer as a hidden service this
# severs the link between submitter and chain.
TOR_ENABLED=false
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
