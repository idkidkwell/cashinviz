# WalletConnect / Reown project ID.
#
# The project's production ID is HARDCODED in src/lib/wagmi.ts so a
# fresh clone Just Works without any .env file. You only need to set
# this variable if you want connection metrics to land in YOUR Reown
# dashboard instead of the project's. Get a free ID at:
#   https://cloud.reown.com  (or https://cloud.walletconnect.com — same)
#
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Relayer URL (local dev)
NEXT_PUBLIC_RELAYER_URL=http://localhost:4000
